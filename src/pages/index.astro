---
import AppLayout from '../layouts/AppLayout.astro';
import ListCard from '../components/lists/ListCard.astro';
---

<AppLayout fullWidth>
	<section class="home">
		<h1 class="sr-only">My lists</h1>
		<div class="cards">
			<ListCard kind="to_watch" name="To watch" />
			<ListCard kind="favorites" name="Favorites" />
			<ListCard kind="watched" name="Watched" />
		</div>
	</section>

	<script>
		import { supabase } from '../lib/supabase.js';
		import { getListSummaries, LISTS_CHANGED_EVENT, type ListSummary } from '../lib/lists/store';
		import { posterUrl } from '../lib/tmdb/images';

		// A navegação troca a página sem recarregar o script, então a tela é montada a cada visita.
		// Depois que o onboarding é concluído, não muda mais nesta aba: não precisa consultar de novo.
		// Fica fora da montagem da tela, para sobreviver às navegações.
		let onboardingDone = false;
		let homeRefresh: (() => Promise<void>) | null = null;
		window.addEventListener(LISTS_CHANGED_EVENT, () => void homeRefresh?.());

		const setupHome = () => {
		// Proteção da rota: sem sessão vai para o login; sem onboarding vai para o onboarding.
		const redirectIfNeeded = async () => {
			const { data: sessionData } = await supabase.auth.getSession();
			const session = sessionData.session;
			if (!session) {
				window.location.replace('/login');
				return false;
			}
			if (onboardingDone) return true;

			const { data: profile } = await supabase
				.from('profiles')
				.select('onboarding_completed')
				.eq('user_id', session.user.id)
				.single();
			if (!profile?.onboarding_completed) {
				window.location.replace('/onboarding');
				return false;
			}
			onboardingDone = true;
			return true;
		};

		// Preenche um card: contador e prévia em leque (centro = mais recente).
		const renderCard = (summary: ListSummary) => {
			const card = document.querySelector<HTMLElement>(`[data-list-kind="${summary.kind}"]`);
			if (!card) return;

			card.querySelector<HTMLElement>('[data-count]')!.textContent = String(summary.count);

			const slots = card.querySelectorAll<HTMLElement>('[data-poster]');
			// Ordem visual: esquerda, centro (mais recente), direita.
			const order = [1, 0, 2];
			order.forEach((slotIndex, position) => {
				const slot = slots[slotIndex];
				const item = summary.recent[position];
				const poster = posterUrl(item?.posterPath ?? null);

				slot.classList.remove('poster--loading');
				if (poster) {
					slot.style.backgroundImage = `url("${poster}")`;
					slot.style.backgroundSize = 'cover';
				} else {
					slot.classList.add('poster--silhouette');
				}
			});
		};

		const refresh = async () => {
			try {
				const summaries = await getListSummaries();
				summaries.forEach(renderCard);
			} catch (error) {
				console.error(error);
				// Sem dados: os pôsteres param de carregar e mostram a silhueta.
				document.querySelectorAll('[data-poster].poster--loading').forEach((slot) => {
					slot.classList.remove('poster--loading');
					slot.classList.add('poster--silhouette');
				});
			}
		};

			homeRefresh = refresh;
			redirectIfNeeded().then((ok) => {
				if (ok) refresh();
			});
		};

		document.addEventListener('astro:page-load', () => {
			if (document.querySelector('.home')) setupHome();
		});
	</script>
</AppLayout>

<style>
	.home {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* Três cards lado a lado ocupando toda a largura; empilhados em telas estreitas. */
	.cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
		width: 100%;
	}

	@media (max-width: 767px) {
		.cards {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
