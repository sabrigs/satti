---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import { getRandomBackdrop } from '../lib/tmdb/titles';

// Backdrop aleatório da TMDB; sem token ou com erro, usa a imagem estática.
const FALLBACK_BACKDROP = '/background.webp';
const backdropPath = await getRandomBackdrop().catch(() => null);
const backdrop = backdropPath
	? `https://image.tmdb.org/t/p/w1280${backdropPath}`
	: FALLBACK_BACKDROP;
---

<Layout>
	<main>
		<div id="background" style={`--backdrop: url("${backdrop}");`}>
			<section id="login">
				<div id="panel">
					<form id="login-form" novalidate>
						<h1 class="brand">Aurora</h1>
						<p class="caption">Take your movies and TV shows to whatever you go.</p>

						<div class="field">
							<input id="input-email" type="email" autocomplete="email" name="email" placeholder="Email" required aria-label="Email" aria-describedby="email-error" />
							<p id="email-error" class="error" role="alert" hidden></p>
						</div>

						<Button id="submit-button" type="submit" label="Continue with email" class="pill" />
					</form>

					<div id="sent" class="sent" hidden>
						<h1 class="sent-title">Check your email</h1>
						<p class="sent-text">To continue, click in the link sent to</p>
						<p class="sent-email"><strong id="sent-email"></strong></p>
						<p class="sent-retry">Not finding the email? <button type="button" id="change-email" class="link">Try again</button></p>
					</div>
				</div>
			</section>
		</div>
	</main>


	<script>
		import { supabase } from '../lib/supabase.js';

		const form = document.getElementById('login-form') as HTMLFormElement;
		const emailInput = document.getElementById('input-email') as HTMLInputElement;
		const errorText = document.getElementById('email-error') as HTMLParagraphElement;
		const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
		const sent = document.getElementById('sent') as HTMLDivElement;
		const sentEmail = document.getElementById('sent-email') as HTMLElement;
		const changeEmail = document.getElementById('change-email') as HTMLButtonElement;

		const showError = (message: string) => {
			errorText.textContent = message;
			errorText.hidden = false;
			emailInput.setAttribute('aria-invalid', 'true');
		};

		const clearError = () => {
			errorText.textContent = '';
			errorText.hidden = true;
			emailInput.removeAttribute('aria-invalid');
		};

		const setSending = (sending: boolean) => {
			submitButton.disabled = sending;
			submitButton.textContent = sending ? 'Sending...' : 'Continue with email';
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			clearError();

			const email = emailInput.value.trim();
			if (!emailInput.checkValidity() || !email) {
				showError('Enter a valid email address.');
				return;
			}

			setSending(true);
			const { error } = await supabase.auth.signInWithOtp({
				email,
				options: { emailRedirectTo: `${window.location.origin}/auth/callback` },
			});
			setSending(false);

			if (error) {
				showError('We could not send the link. Try again in a moment.');
				console.error(error);
				return;
			}

			sentEmail.textContent = email;
			form.hidden = true;
			sent.hidden = false;
		});

		changeEmail.addEventListener('click', () => {
			sent.hidden = true;
			form.hidden = false;
			emailInput.focus();
		});
	</script>

	<style>
		/* A tela cabe na altura da janela: sem scroll. */
		:global(html),
		:global(body) {
			height: 100%;
			overflow: hidden;
		}

		main {
			box-sizing: border-box;
			height: 100dvh;
			padding: 16px;
		}

		:focus-visible {
			outline: 2px solid var(--color-info-text);
			outline-offset: 2px;
		}

		#background {
			position: relative;
			height: 100%;
			border-radius: 16px;
			overflow: hidden;
			background-color: var(--color-bg);
		}

		#login {
			position: relative;
			height: 100%;
		}

		#panel {
			box-sizing: border-box;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 32px;
			height: 100%;
			padding: 32px 24px;
			border-radius: 16px;
			background-color: var(--color-surface);
			text-align: center;
		}

		h1 {
			margin: 0;
			font-family: var(--font-serif);
			font-weight: 700;
			font-size: 3rem;
			line-height: 1.1;
			color: var(--color-text);
		}

		#login-form,
		.sent {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 24px;
			width: 100%;
			max-width: 380px;
		}

		.caption,
		.sent-text,
		.sent-retry {
			margin: 0;
			font-size: 1.125rem;
			line-height: 1.5;
			color: var(--color-text-muted);
		}

		.sent-email {
			margin: 0;
			font-size: 1.125rem;
			color: var(--color-text);
		}

		.field {
			display: flex;
			flex-direction: column;
			gap: 8px;
			width: 100%;
		}

		input {
			height: 56px;
			padding-inline: 18px;
			border: 1px solid var(--color-border);
			border-radius: 12px;
			background-color: var(--color-surface-hover);
			color: var(--color-text);
			font: inherit;
			font-size: 1.0625rem;
		}

		input::placeholder {
			color: var(--color-text-muted);
		}

		input[aria-invalid='true'] {
			border-color: var(--color-danger-border);
		}

		.error {
			margin: 0;
			font-size: 0.875rem;
			text-align: left;
			color: var(--color-danger-text);
		}

		#login-form :global(.pill) {
			width: 100%;
			height: 56px;
			border-radius: 999px;
			font: inherit;
			font-size: 1.0625rem;
			font-weight: 600;
		}

		.link {
			padding: 0;
			border: 0;
			background: none;
			font: inherit;
			color: var(--color-info-text);
			text-decoration: underline;
			cursor: pointer;
		}

		[hidden] {
			display: none !important;
		}

		/* Desktop: backdrop à esquerda e o formulário ocupa a metade direita. */
		@media (min-width: 900px) {
			#background {
				background-image: var(--backdrop);
				background-size: cover;
				background-position: center;
			}

			#login {
				position: absolute;
				top: 24px;
				right: 24px;
				bottom: 24px;
				width: calc(50% - 24px);
				height: auto;
			}
		}

		/* Telas estreitas: sem backdrop, só o formulário. */
		@media (max-width: 899px) {
			#login {
				height: 100%;
			}

			#panel {
				border-radius: 16px;
			}

			h1 {
				font-size: 2.5rem;
			}
		}
	</style>
</Layout>
