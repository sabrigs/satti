---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Title from '../components/ui/Title.astro';
import InputField from '../components/ui/InputField.astro';
import { getTopBrazilProviders, type StreamingProvider } from '../lib/streaming/availability';

// Os 5 streamings mais usados no Brasil (TMDB watch providers).
// Se a API falhar, a lista fica vazia e o usuário ainda pode concluir.
const providers: StreamingProvider[] = await getTopBrazilProviders('movie', 5).catch(() => []);
const logoBase = 'https://image.tmdb.org/t/p/w92';
---

<Layout>
	<main>
		<section id="onboarding" aria-live="polite">
			<div id="card">
				<form id="step-name" class="step" novalidate>
					<h1>How would you like to be called?</h1>
					<div class="field">
						<label class="sr-only" for="input-name">Name</label>
						<InputField id="input-name" name="name" type="text" placeholder="Name" autocomplete="given-name" required />
					</div>
					<Button id="next-button" type="submit" label="Next" class="pill" disabled />
				</form>

				<div id="step-streamings" class="step" hidden>
					<h1>Your streamings</h1>

					{providers.length === 0 && (
						<p class="error">We could not load the streaming services right now. You can add them later.</p>
					)}

					<fieldset class="streamings">
						<legend class="sr-only">Streaming services</legend>
						{providers.map((provider) => (
							<label class="streaming-option">
								<input type="checkbox" name="streaming" value={provider.id} data-name={provider.name} />
								<span>{provider.name}</span>
							</label>
						))}
					</fieldset>

					<p id="save-error" class="error" role="alert" hidden></p>

					<div class="actions">
						<Button id="back-button" variant="secondary" label="Back" class="pill" />
						<Button id="finish-button" label="Finish" class="pill" />
					</div>
				</div>
			</div>
		</section>
	</main>

	<script id="providers-data" type="application/json" set:html={JSON.stringify(providers)} />

	<script>
		import { supabase } from '../lib/supabase.js';

		const stepName = document.getElementById('step-name') as HTMLFormElement;
		const stepStreamings = document.getElementById('step-streamings') as HTMLDivElement;
		const nameInput = document.getElementById('input-name') as HTMLInputElement;
		const nextButton = document.getElementById('next-button') as HTMLButtonElement;
		const backButton = document.getElementById('back-button') as HTMLButtonElement;
		const finishButton = document.getElementById('finish-button') as HTMLButtonElement;
		const saveError = document.getElementById('save-error') as HTMLParagraphElement;
		const providers: { id: number; name: string; logoPath: string | null }[] = JSON.parse(
			document.getElementById('providers-data')?.textContent ?? '[]',
		);

		const showError = (message: string) => {
			saveError.textContent = message;
			saveError.hidden = false;
		};

		const setSaving = (saving: boolean) => {
			finishButton.disabled = saving;
			finishButton.textContent = saving ? 'Saving...' : 'Finish';
		};

		// Proteção da rota: precisa estar logado e ainda não ter concluído o onboarding.
		const { data: sessionData } = await supabase.auth.getSession();
		const session = sessionData.session;
		if (!session) {
			window.location.replace('/login');
		} else {
			const { data: profile, error } = await supabase
				.from('profiles')
				.select('onboarding_completed, display_name')
				.eq('user_id', session.user.id)
				.single();

			if (error) {
				console.error(error);
			} else if (profile?.onboarding_completed) {
				window.location.replace('/');
			} else if (profile?.display_name) {
				nameInput.value = profile.display_name;
				nextButton.disabled = false;
			}
		}

		// Passo 1: o botão "Next" só habilita com algum nome preenchido.
		const updateNext = () => {
			nextButton.disabled = nameInput.value.trim() === '';
		};
		nameInput.addEventListener('input', updateNext);
		updateNext();

		stepName.addEventListener('submit', (event) => {
			event.preventDefault();
			if (nameInput.value.trim() === '') return;
			stepName.hidden = true;
			stepStreamings.hidden = false;
			(stepStreamings.querySelector('input[type="checkbox"]') as HTMLInputElement | null)?.focus();
		});

		// Passo 2: "Back" volta ao nome, mantendo a seleção de streamings.
		backButton.addEventListener('click', () => {
			stepStreamings.hidden = true;
			stepName.hidden = false;
			nameInput.focus();
		});

		// "Finish" salva o nome, os streamings escolhidos e marca o onboarding como concluído.
		// Pode ser concluído sem nenhum streaming selecionado.
		finishButton.addEventListener('click', async () => {
			if (!session) return;
			saveError.hidden = true;
			setSaving(true);

			const selected = [...stepStreamings.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')]
				.map((input) => providers.find((provider) => String(provider.id) === input.value))
				.filter((provider): provider is (typeof providers)[number] => Boolean(provider));

			const userId = session.user.id;
			const { error: profileError } = await supabase
				.from('profiles')
				.update({ display_name: nameInput.value.trim(), onboarding_completed: true })
				.eq('user_id', userId);

			if (profileError) {
				console.error(profileError);
				setSaving(false);
				showError('We could not save your details. Try again.');
				return;
			}

			const { error: deleteError } = await supabase.from('user_streamings').delete().eq('user_id', userId);
			if (deleteError) {
				console.error(deleteError);
				setSaving(false);
				showError('We could not save your streamings. Try again.');
				return;
			}

			if (selected.length > 0) {
				const { error: insertError } = await supabase.from('user_streamings').insert(
					selected.map((provider) => ({
						user_id: userId,
						provider_id: provider.id,
						provider_name: provider.name,
						logo_path: provider.logoPath,
					})),
				);
				if (insertError) {
					console.error(insertError);
					setSaving(false);
					showError('We could not save your streamings. Try again.');
					return;
				}
			}

			window.location.replace('/');
		});
	</script>

	<style>
		:global(html),
		:global(body) {
			height: 100%;
			overflow: hidden;
		}

		[hidden] {
			display: none !important;
		}

		main {
			box-sizing: border-box;
			height: 100dvh;
			padding: 16px;
		}

		#onboarding {
			height: 100%;
		}

		#card {
			box-sizing: border-box;
			display: flex;
			align-items: center;
			justify-content: center;
			height: 100%;
			padding: 32px 24px;
			border-radius: 16px;
			background-color: var(--color-surface);
		}

		.step {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 32px;
			width: 100%;
			max-width: 320px;
		}

		h1 {
			margin: 0;
			font-family: var(--font-serif);
			font-size: 2.5rem;
			font-weight: 700;
			line-height: 1.1;
			text-align: center;
			color: var(--color-text);
		}

		.field {
			width: 100%;
		}

		#input-name {
			width: 100%;
			height: 56px;
			padding-inline: 18px;
			border: 1px solid var(--color-border);
			border-radius: 12px;
			background-color: var(--color-surface-hover);
			color: var(--color-text);
			font: inherit;
			font-size: 1.0625rem;
		}

		#input-name::placeholder {
			color: var(--color-text-muted);
		}

		#step-name :global(.pill),
		.actions :global(.pill) {
			width: 100%;
			height: 56px;
			border-radius: 999px;
			font: inherit;
			font-size: 1rem;
			font-weight: 600;
		}

		.streamings {
			display: flex;
			flex-direction: column;
			gap: 24px;
			width: 100%;
			margin: 0;
			padding: 0;
			border: 0;
		}

		.streaming-option {
			display: flex;
			align-items: center;
			gap: 12px;
			font-size: 1rem;
			color: var(--color-text);
			cursor: pointer;
		}

		.streaming-option input {
			width: 20px;
			height: 20px;
			margin: 0;
			accent-color: var(--color-selected);
			cursor: pointer;
		}

		.actions {
			display: flex;
			gap: 12px;
			width: 100%;
		}

		.actions > * {
			flex: 1;
		}

		.error {
			margin: 0;
			font-size: 0.875rem;
			color: var(--color-danger-text);
		}

		.sr-only {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
			white-space: nowrap;
		}
	</style>
</Layout>
