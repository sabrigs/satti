---
import AppLayout from '../../../layouts/AppLayout.astro';
import AddStatusButton from '../../../components/titles/AddStatusButton.astro';
import { getTitleDetails, isInBrazilTheaters, type TitleDetails } from '../../../lib/tmdb/titles';
import { getTitleStreamingProviders, type StreamingProvider } from '../../../lib/streaming/availability';
import { logoUrl, posterUrl } from '../../../lib/tmdb/images';
import type { MediaType } from '../../../lib/tmdb/client';

const mediaType = Astro.params.mediaType;
const id = Number(Astro.params.id);

if ((mediaType !== 'movie' && mediaType !== 'tv') || !Number.isInteger(id)) {
	return Astro.redirect('/');
}

let details: TitleDetails;
let providers: StreamingProvider[];
let inTheaters: boolean;
try {
	[details, providers, inTheaters] = await Promise.all([
		getTitleDetails(mediaType as MediaType, id),
		getTitleStreamingProviders(mediaType as MediaType, id).catch(() => []),
		isInBrazilTheaters(mediaType as MediaType, id).catch(() => false),
	]);
} catch {
	return Astro.redirect('/');
}

const category = details.mediaType === 'movie' ? 'Movie' : 'Series';
const duration = details.runtime
	? details.runtime >= 60
		? `${Math.floor(details.runtime / 60)}h ${details.runtime % 60}min`
		: `${details.runtime}min`
	: null;
const genre = details.genres.slice(0, 2).join(', ') || null;
const rating = details.voteAverage > 0 ? `★ ${details.voteAverage.toFixed(1)}` : null;
const metadata = [category, duration, genre, rating].filter(Boolean).join(' · ');

const backdrop = details.backdropPath ? `https://image.tmdb.org/t/p/w1280${details.backdropPath}` : null;
const poster = posterUrl(details.posterPath, 'w342');
---

<AppLayout fullWidth>
	<article class="title">
		<div class="hero" style={backdrop ? `--backdrop: url("${backdrop}");` : undefined}>
			<div class="hero-bar">
				<a class="back" href="/" data-back>
					<span class="back-icon" aria-hidden="true">
						<svg width="18" height="18" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</span>
					<span class="back-label">Back</span>
				</a>
				<AddStatusButton tmdbId={details.id} mediaType={details.mediaType} title={details.title} posterPath={details.posterPath} />
			</div>

			<div class="hero-text">
				<h1>{details.title}</h1>
				<p class="metadata">{metadata}</p>
			</div>
		</div>

		<div class="content">
			{(inTheaters || providers.length > 0) && (
				<section class="block" aria-labelledby="available-on">
					<h2 id="available-on">Available on</h2>
					{inTheaters ? (
						<ul class="providers">
							<li class="theater-chip">In theaters</li>
						</ul>
					) : (
						<ul class="providers">
							{providers.map((provider) => (
								<li>
									{provider.logoPath ? (
										<img src={logoUrl(provider.logoPath, 'w92') ?? ''} alt="" width="40" height="40" />
									) : null}
									<span>{provider.name}</span>
								</li>
							))}
						</ul>
					)}
				</section>
			)}

			{details.overview && (
				<section class="block" aria-labelledby="about">
					<h2 id="about">About</h2>
					<p class="about">{details.overview}</p>
				</section>
			)}

			{details.cast.length > 0 && (
				<section class="block" aria-labelledby="cast">
					<h2 id="cast">Cast</h2>
					<ul class="cast">
						{details.cast.map((member) => (
							<li class="cast-member">
								<span class="cast-photo" style={member.profilePath ? `background-image: url("${posterUrl(member.profilePath, 'w185')}");` : undefined} aria-hidden="true"></span>
								<span class="cast-name">{member.name}</span>
								{member.character && <span class="cast-role">{member.character}</span>}
							</li>
						))}
					</ul>
				</section>
			)}
		</div>
	</article>
</AppLayout>

<script>
	import { bindBackLink } from '../../../lib/ui/navigation';

	// A navegação troca a página sem recarregar o script: liga o botão e o rótulo a cada visita.
	document.addEventListener('astro:page-load', () => {
		const back = document.querySelector<HTMLAnchorElement>('[data-back]');
		if (back) bindBackLink(back);
	});
</script>

<style>
	/* Backdrop de borda a borda, logo abaixo da navbar fixa (64px). */
	.title {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.hero {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		height: clamp(300px, 45vw, 440px);
		margin: -24px -16px 0;
		padding: 16px;
		background-color: var(--color-surface);
		background-image: var(--backdrop, none);
		background-size: cover;
		background-position: center;
	}

	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, #00000066 0%, #00000000 30%, #000000cc 100%);
		pointer-events: none;
	}

	.hero-bar {
		position: absolute;
		top: 16px;
		left: 16px;
		right: 16px;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.hero-text {
		position: relative;
		z-index: 1;
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--color-text);
		font-weight: 600;
		text-decoration: none;
	}

	.back-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 999px;
		background-color: #ffffff1a;
		backdrop-filter: blur(8px);
	}

	h1 {
		margin: 0 0 8px;
		font-size: 2.25rem;
		font-weight: 700;
		color: #fff;
	}

	.metadata {
		margin: 0;
		color: #ffffffcc;
		font-size: 1rem;
	}

	/* Conteúdo com a margem de 16px, como o restante das páginas. */
	.content {
		display: flex;
		flex-direction: column;
		gap: 32px;
		max-width: 1000px;
	}

	.block {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.providers {
		display: flex;
		flex-wrap: wrap;
		gap: 16px 24px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.providers li {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 1rem;
		color: var(--color-text);
	}

	.providers img {
		width: 40px;
		height: 40px;
		border-radius: 10px;
	}

	.theater-chip {
		padding: 8px 14px;
		border-radius: 999px;
		background-color: var(--color-success-bg);
		border: 1px solid var(--color-success-border);
		color: var(--color-success-text);
		font-weight: 600;
	}

	.about {
		margin: 0;
		line-height: 1.5;
		color: var(--color-text);
	}

	.cast {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cast-member {
		display: flex;
		flex-direction: column;
		gap: 4px;
		min-width: 0;
	}

	.cast-photo {
		display: block;
		aspect-ratio: 2 / 3;
		border-radius: 12px;
		background-color: var(--color-surface-raised);
		background-image: linear-gradient(180deg, var(--color-surface-hover), var(--color-surface-raised));
		background-size: cover;
		background-position: center;
		margin-bottom: 8px;
	}

	.cast-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-weight: 600;
		color: var(--color-text);
	}

	.cast-role {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	@media (max-width: 1023px) {
		.cast {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 767px) {
		.cast {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		h1 {
			font-size: 1.75rem;
		}
	}
</style>
