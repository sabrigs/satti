---
import Layout from './Layout.astro';
import AppHeader from '../components/app/AppHeader.astro';
import BottomNav from '../components/app/BottomNav.astro';
import '../styles/popover.css';

---

<Layout>
	<AppHeader />
	<main class="app-main">
		<slot />
	</main>
	<BottomNav />
</Layout>

<style>
	.app-main {
		min-height: calc(100dvh - 64px);
		padding: 24px 16px 96px;
		max-width: 1100px;
		margin-inline: auto;
	}

	@media (min-width: 768px) {
		.app-main {
			padding-bottom: 24px;
		}
	}
</style>
