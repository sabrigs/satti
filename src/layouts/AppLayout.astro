---
import Layout from './Layout.astro';
import AppHeader from '../components/app/AppHeader.astro';
import BottomNav from '../components/app/BottomNav.astro';
import '../styles/popover.css';

interface Props {
	// Ocupa toda a largura da tela (com a margem de 16px), em vez de limitar a 1100px.
	fullWidth?: boolean;
}

const { fullWidth = false } = Astro.props;
---

<Layout>
	<div transition:persist="app-header">
		<AppHeader />
	</div>
	<main class:list={['app-main', { 'app-main--full': fullWidth }]}>
		<slot />
	</main>
	<BottomNav />
</Layout>

<style>
	.app-main {
		padding: 24px 16px 112px;
		max-width: 1100px;
		margin-inline: auto;
	}

	.app-main--full {
		max-width: none;
	}

	@media (min-width: 768px) {
		.app-main {
			padding-bottom: 24px;
		}
	}
</style>
