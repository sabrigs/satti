---
import { getTopBrazilProviders } from '../../lib/streaming/availability';
import { logoUrl } from '../../lib/tmdb/images';

// Os mesmos 5 streamings do onboarding, para adicionar pelo menu.
const providers = await getTopBrazilProviders('movie', 5).catch(() => []);
const providersForClient = providers.map((provider) => ({
	id: provider.id,
	name: provider.name,
	logoPath: provider.logoPath,
	logoUrl: logoUrl(provider.logoPath),
}));
---

<button type="button" class="avatar" id="avatar-button" aria-haspopup="dialog" aria-label="Open account menu">
	<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
</button>

<dialog class="popover" id="avatar-menu" aria-label="Account">
	<div id="avatar-main" class="menu">
		<div class="menu-header">
			<strong id="avatar-name"></strong>
			<span id="avatar-member-since"></span>
		</div>
		<button type="button" class="menu-item" id="open-streamings">
			<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="M9 3l3 4 3-4" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg><span>My streamings</span><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class="chevron"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
		</button>
		<button type="button" class="menu-item" id="export-data" hidden>
			<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4M4 20h16" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Export data</span>
		</button>
		<button type="button" class="menu-item" id="sign-out">
			<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h4a2 2 0 012 2v12a2 2 0 01-2 2h-4M10 8l-4 4 4 4M6 12h10" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Sign out</span>
		</button>
	</div>

	<div id="avatar-streamings" class="menu" hidden>
		<div class="streamings-header">
			<button type="button" class="icon-button" id="back-to-menu" aria-label="Back"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
			<strong>My streamings</strong>
		</div>
		<div id="streaming-checklist" class="menu" role="group" aria-label="My streamings"></div>
	</div>
</dialog>

<script id="avatar-providers" type="application/json" set:html={JSON.stringify(providersForClient)} />

<style>
	.avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 999px;
		border: 1px solid var(--color-border-strong);
		background-color: var(--color-surface-raised);
		color: var(--color-text);
		font-weight: 600;
		cursor: pointer;
	}

	.avatar:hover {
		background-color: var(--color-surface-hover);
	}

	.streamings-header {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 4px 4px 12px;
		font-size: 1.25rem;
		font-weight: 600;
	}

	.icon-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 999px;
		border: 0;
		background-color: var(--color-surface-hover);
		color: var(--color-text);
		cursor: pointer;
	}
</style>

<script>
	import { supabase } from '../../lib/supabase.js';
	import {
		addStreaming,
		getUserStreamings,
		removeStreaming,
		type StreamingRow,
	} from '../../lib/lists/store';
	import { enableLightDismiss, openPopover } from '../../lib/ui/popover';
	import { downloadExport, hasExportableData } from '../../lib/lists/export';
	import { brandName } from '../../lib/streaming/canonical';

	type Provider = { id: number; name: string; logoPath: string | null; logoUrl: string | null };

	const avatarButton = document.getElementById('avatar-button') as HTMLButtonElement;
	const menu = document.getElementById('avatar-menu') as HTMLDialogElement;
	const mainPanel = document.getElementById('avatar-main') as HTMLDivElement;
	const streamingsPanel = document.getElementById('avatar-streamings') as HTMLDivElement;
	const nameEl = document.getElementById('avatar-name') as HTMLElement;
	const memberSince = document.getElementById('avatar-member-since') as HTMLSpanElement;
	const checklist = document.getElementById('streaming-checklist') as HTMLDivElement;
	const providers: Provider[] = JSON.parse(
		document.getElementById('avatar-providers')?.textContent ?? '[]',
	);

	type ChecklistRow = { brand: string; owned: boolean; provider: Provider | null; stored: StreamingRow | null };

	// Lista única: os streamings marcados ficam em cima, os desmarcados embaixo.
	// A ordem é definida ao abrir a lista; clicar só muda a marcação, sem reordenar.
	const renderStreamings = (owned: StreamingRow[]) => {
		const storedByBrand = new Map(owned.map((row) => [brandName(row.providerName), row]));
		const rows: ChecklistRow[] = providers.map((provider) => ({
			brand: provider.name,
			owned: storedByBrand.has(provider.name),
			provider,
			stored: storedByBrand.get(provider.name) ?? null,
		}));

		// Streamings salvos que não estão entre os 5 principais continuam visíveis e marcados.
		for (const [brand, stored] of storedByBrand) {
			if (!providers.some((provider) => provider.name === brand)) {
				rows.push({ brand, owned: true, provider: null, stored });
			}
		}

		rows.sort((a, b) => Number(b.owned) - Number(a.owned));
		checklist.replaceChildren(...rows.map((row) => checkItem(row)));
	};

	const checkItem = (row: ChecklistRow) => {
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'menu-item check-item';
		button.setAttribute('role', 'menuitemcheckbox');
		button.setAttribute('aria-checked', String(row.owned));

		const box = document.createElement('span');
		box.className = 'check-box';
		box.setAttribute('aria-hidden', 'true');
		button.append(box, row.brand);

		button.addEventListener('click', async () => {
			// Atualiza na hora; se o Supabase falhar, volta ao estado anterior.
			const wasChecked = row.owned;
			row.owned = !wasChecked;
			button.setAttribute('aria-checked', String(row.owned));

			try {
				if (row.owned && row.provider) {
					await addStreaming(row.provider);
					row.stored = { providerId: row.provider.id, providerName: row.provider.name, logoPath: row.provider.logoPath };
				} else if (row.stored) {
					await removeStreaming(row.stored.providerId);
					row.stored = null;
				}
			} catch (error) {
				console.error(error);
				row.owned = wasChecked;
				button.setAttribute('aria-checked', String(wasChecked));
			}
		});

		return button;
	};

	const showPanel = (panel: 'main' | 'streamings') => {
		mainPanel.hidden = panel !== 'main';
		streamingsPanel.hidden = panel !== 'streamings';
	};

	const loadProfile = async () => {
		const { data: sessionData } = await supabase.auth.getSession();
		const session = sessionData.session;
		if (!session) return;

		const { data: profile } = await supabase
			.from('profiles')
			.select('display_name, created_at')
			.eq('user_id', session.user.id)
			.single();

		const name = profile?.display_name || session.user.email || 'You';
		nameEl.textContent = name;
		if (profile?.created_at) {
			const date = new Date(profile.created_at).toLocaleDateString('en-US', {
				month: 'short',
				day: 'numeric',
				year: 'numeric',
			});
			memberSince.textContent = `Member since ${date}`;
		}
	};

	avatarButton.addEventListener('click', () => {
		showPanel('main');
		openPopover(menu, avatarButton);
		// "Export data" só aparece quando há dados para exportar.
		hasExportableData()
			.then((hasData) => {
				document.getElementById('export-data')!.hidden = !hasData;
			})
			.catch((error) => console.error(error));
	});

	enableLightDismiss(menu);

	document.getElementById('open-streamings')?.addEventListener('click', async () => {
		showPanel('streamings');
		renderStreamings(await getUserStreamings());
	});

	document.getElementById('back-to-menu')?.addEventListener('click', () => showPanel('main'));

	document.getElementById('export-data')?.addEventListener('click', async (event) => {
		const button = event.currentTarget as HTMLButtonElement;
		button.disabled = true;
		try {
			await downloadExport();
			menu.close();
		} catch (error) {
			console.error(error);
			window.alert('We could not export your data. Try again.');
		} finally {
			button.disabled = false;
		}
	});

	document.getElementById('sign-out')?.addEventListener('click', async () => {
		await supabase.auth.signOut();
		window.location.replace('/login');
	});

	loadProfile().catch((error) => console.error(error));
</script>
