---
// Card de lista da Home: título, contador no canto superior direito e
// prévia em leque com os 3 últimos títulos. A Home preenche os dados no cliente.
interface Props {
  kind: 'to_watch' | 'watched' | 'favorites';
  name: string;
}

const { kind, name } = Astro.props;
---

<a class="list-card" href={`/lists/${kind}`} data-list-kind={kind}>
  <div class="list-card__header">
    <h2>{name}</h2>
    <span class="count" data-count aria-label="Titles in list">0</span>
  </div>
  <div class="fan" aria-hidden="true">
    <span class="poster poster--silhouette" data-poster></span>
    <span class="poster poster--silhouette" data-poster></span>
    <span class="poster poster--silhouette" data-poster></span>
  </div>
</a>

<style>
  .list-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px;
    border-radius: 16px;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
  }

  .list-card:hover {
    background-color: var(--color-surface-raised);
  }

  .list-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  h2 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .count {
    min-width: 28px;
    padding: 2px 8px;
    border-radius: 999px;
    background-color: var(--color-surface-hover);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    text-align: center;
  }

  .fan {
    position: relative;
    height: 170px;
    margin-top: 4px;
  }

  .poster {
    position: absolute;
    top: 0;
    left: 50%;
    width: 100px;
    aspect-ratio: 2 / 3;
    margin-left: -50px;
    border-radius: 10px;
    border: 1px solid var(--color-border-strong);
    background-color: var(--color-surface-raised);
    box-shadow: 0 6px 16px #00000055;
    transform-origin: 50% 100%;
  }

  .poster:nth-child(1) {
    transform: rotate(-12deg) translateX(-56px);
    z-index: 1;
  }

  .poster:nth-child(2) {
    transform: rotate(0deg);
    z-index: 2;
  }

  .poster:nth-child(3) {
    transform: rotate(12deg) translateX(56px);
    z-index: 1;
  }

  .poster--silhouette {
    background-image: linear-gradient(180deg, var(--color-surface-hover), var(--color-surface-raised));
  }
</style>
