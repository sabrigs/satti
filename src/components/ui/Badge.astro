---
interface Props {
  variant?: 'success' | 'danger';
  label?: string;
}

const { variant = 'success', label } = Astro.props;
---

<span class:list={['badge', `badge--${variant}`]}>
  {variant === 'success' && <span class="badge__icon" aria-hidden="true">✓</span>}
  <slot>{label}</slot>
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 28px;
    padding-inline: 10px;
    border-radius: 999px;
    border: 1px solid;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .badge--success {
    background-color: var(--color-success-bg);
    border-color: var(--color-success-border);
    color: var(--color-success-text);
  }

  .badge--danger {
    background-color: var(--color-danger-bg);
    border-color: var(--color-danger-border);
    color: var(--color-danger-text);
  }
</style>
