---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  label?: string;
  variant?: 'primary' | 'secondary';
  size?: 'small' | 'medium' | 'large';
}

const {
  label,
  variant = 'primary',
  size = 'medium',
  class: className,
  ...attrs
} = Astro.props;
---

<button
  {...attrs}
  class:list={['button', `button--${variant}`, `button--${size}`, className]}
>
  <slot>{label}</slot>
</button>

<style>
  .button {
    cursor: pointer;
    height: 48px;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    box-shadow: 0px 2px 5px 0px #0000001f;
  }

  .button--primary {
    background-color: var(--color-solid);
    color: var(--color-on-solid);
  }

  .button--primary:hover:not(:disabled) {
    background-color: var(--color-solid-hover);
  }

  .button--secondary {
    background-color: var(--color-surface-raised);
    color: var(--color-text);
  }

  .button--secondary:hover:not(:disabled) {
    background-color: var(--color-surface-hover);
  }

  .button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .button--small {
    padding: 8px 12px;
  }

  .button--medium {
    padding: 12px 16px;
  }

  .button--large {
    padding: 16px 24px;
  }
</style>
